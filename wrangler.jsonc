// Cloudflare deploys the live site from here on every push to main (her ask, 2026-09-16).
// Only dist/ is published — the notes, the source and the drafts in this repo never are.
// Rebuild dist before committing:  python3 tools/build.py && python3 tools/publish.py
// The domains live HERE, not only in the dashboard: a deploy replaces whatever this file does not list
// (a push on 2026-09-17 dropped the dashboard-added domain and the site went down).
{
  "name": "repo-2",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "yeraldinsoto.com", "custom_domain": true },
    { "pattern": "www.yeraldinsoto.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
